<view class="container">
  <view class="profile-info">
    <image class="avatar" src="{{userInfo.avatar || 'http://yanxuan.nosdn.127.net/8945ae63d940cc42406c3f67019c5cb6.png'}}"></image>
    <view class="info">
      <text class="name">{{userInfo.nickname}}</text>
    </view>
  </view>
  <view class="menu">
    <view class="item" bindtap="onChangePassword">
      <text class="txt">修改密码</text>
      <image class="arrow" src="/static/images/address_right.png"></image>
    </view>
    <view class="item" bindtap="onLogout">
      <text class="txt">退出登录</text>
      <image class="arrow" src="/static/images/address_right.png"></image>
    </view>
  </view>
</view>
